# Browser-safe live mode is opt-in; leave unset for static replay.
VITE_GAMECAST_MODE=replay
VITE_FEATURED_GAME_ID=401999001

# Vercel/Convex operator provisioning (never expose TYPESAFE_API_KEY, JEV_API_KEY, OPENROUTER_KEY, UPLOADTHING_TOKEN, or CONVEX_WRITE_SECRET to VITE_*).
# CONVEX_URL is preferred. VITE_CONVEX_URL is accepted as an alias (Convex Vite/Vercel default).
CONVEX_URL=https://your-deployment.convex.cloud
TYPESAFE_API_KEY=
JEV_API_KEY=
OPENROUTER_KEY=
UPLOADTHING_TOKEN=
CRON_SECRET=
CONVEX_WRITE_SECRET=
# Production Vercel build (`node scripts/vercel-build.mjs`) runs `npx convex deploy`.
# Convex dashboard → production deployment → Settings → Generate Production Deploy Key.
# Add it to Vercel as CONVEX_DEPLOY_KEY (Production only). Never VITE_*.
CONVEX_DEPLOY_KEY=
LIVE_PUBLIC_ORIGIN=https://your-site.example
FEATURED_GAME_ID=401999001
